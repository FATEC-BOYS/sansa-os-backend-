PORT=3333
HOST=127.0.0.1
DATABASE_URL=postgresql://sansa:sansa_local_only@localhost:5432/sansa_os?schema=public
INTERNAL_API_KEY=replace-with-a-long-random-secret
# Optional, for manual read-only CRM sync. Never commit credentials.
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Pesquisa de comércios: somente busca manual, sem disparo automático
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Configure um contato operacional válido para identificar seu aplicativo na API OSM
OVERPASS_USER_AGENT=SANSA-OS/0.2 (https://sansadigital.com.br)
# Opcional: habilita análise e copy contextual com LLM. Nunca exponha ao frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Escolha do modelo: auto | anthropic | openai | rules
# auto prioriza Claude quando ambas as chaves estão presentes; não envia mensagens automaticamente.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Para Railway, cole JSON INTEGRAL da service account na variável privada, NÃO no repositório.
GOOGLE_SERVICE_ACCOUNT_JSON=
