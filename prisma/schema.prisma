generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String     @id @default(cuid())
  sourceRow      Int        @unique
  name           String
  type           String?
  origin         String?
  channel        String?
  firstContactAt DateTime?
  status         String
  answered       Boolean    @default(false)
  reviewAt       DateTime?
  decision       String?
  nextStep       String?    @db.Text
  notes          String?    @db.Text
  potentialCents Int        @default(0)
  closedCents    Int        @default(0)
  referenceUrl   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  approvals      Approval[]
}

model Approval {
  id         String    @id @default(cuid())
  agent      String
  kind       String
  title      String
  summary    String
  content    String    @db.Text
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

model Activity {
  id        String   @id @default(cuid())
  kind      String
  message   String
  createdAt DateTime @default(now())
}
