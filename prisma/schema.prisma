generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String     @id @default(cuid())
  sourceRow      Int        @unique
  name           String
  type           String?
  origin         String?
  channel        String?
  firstContactAt DateTime?
  status         String
  answered       Boolean    @default(false)
  reviewAt       DateTime?
  decision       String?
  nextStep       String?    @db.Text
  notes          String?    @db.Text
  potentialCents Int        @default(0)
  closedCents    Int        @default(0)
  referenceUrl   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  approvals      Approval[]
}

model Approval {
  id         String    @id @default(cuid())
  agent      String
  kind       String
  title      String
  summary    String
  content    String    @db.Text
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  channel    String?
  prospectId String?
  prospect   LocalProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  mailMessageId String?
  mailMessage MailMessage? @relation(fields: [mailMessageId], references: [id], onDelete: SetNull)
}

model LocalProspect {
  id              String @id @default(cuid())
  sourceKey       String @unique
  name            String
  category        String
  latitude        Float
  longitude       Float
  website         String?
  contactEmail    String?
  contactWhatsapp String?
  socialListed    Boolean @default(false)
  priorityScore   Int
  scoreEvidence   String @db.Text
  status          String @default("shortlisted")
  analysisMode    String?
  analysisSummary String? @db.Text
  approvals       Approval[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model Activity {
  id        String   @id @default(cuid())
  kind      String
  message   String
  createdAt DateTime @default(now())
}

model AgentRun {
  id        String   @id @default(cuid())
  agent     String
  runDate   String
  status    String
  summary   String   @db.Text
  processed Int      @default(0)
  skipped   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agent, runDate])
}

model WhatsAppConversation {
  id               String @id @default(cuid())
  waId             String @unique
  profileName      String?
  stage            String @default("identifier")
  intent           String?
  validationStatus String @default("unverified")
  optedOut         Boolean @default(false)
  handoffRequired  Boolean @default(false)
  lastInboundAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  messages         WhatsAppMessage[]
  approvals        Approval[]
}
model WhatsAppMessage {
  id             String @id @default(cuid())
  metaMessageId  String @unique
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String @default("inbound")
  type           String
  text           String? @db.Text
  receivedAt     DateTime
  createdAt      DateTime @default(now())
  @@index([conversationId, receivedAt])
}

model MailMessage {
  id String @id @default(cuid())
  mailbox String @default("INBOX")
  uidValidity String
  uid Int
  fromAddress String
  senderName String?
  toAddress String
  subject String
  preview String @db.Text
  category String
  receivedAt DateTime
  createdAt DateTime @default(now())
  approvals Approval[]

  @@unique([mailbox,uidValidity,uid])
  @@index([receivedAt])
}
